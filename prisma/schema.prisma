// Prisma schema for AI Stock Hub MVP
// See MVP requirements v0.2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  relationMode = "prisma"
}

model user {
  id        String     @id @db.Uuid
  email     String?
  name      String?
  uploads   upload[]
  downloads download[] @relation("UserDownloads")
  created_at DateTime   @default(now()) @db.Timestamp(6)
}

model upload {
  id        String     @id @default(uuid())
  user      user       @relation(fields: [userId], references: [id])
  userId    String     @db.Uuid
  title     String
  prompt    String
  modelName String
  licence   String // e.g. CC0, Non‑commercial
  fileUrl   String
  llm_keywords String[] // LLM-generated keywords
  llm_description String? // LLM-generated description
  downloads download[]
  created_at DateTime   @default(now())
}

model download {
  id        String   @id @default(uuid())
  upload    upload   @relation(fields: [uploadId], references: [id])
  uploadId  String
  user      user?    @relation("UserDownloads", fields: [userId], references: [id])
  userId    String?  @db.Uuid
  created_at DateTime @default(now())
}
