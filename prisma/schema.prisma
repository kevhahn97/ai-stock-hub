// Prisma schema for AI Stock Hub MVP
// See MVP requirements v0.2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  role         String   @default("consumer") // admin | creator
  uploads      Upload[]
  downloads    Download[] @relation("UserDownloads")
  createdAt    DateTime @default(now())
}

model Upload {
  id          String   @id @default(uuid())
  user        User     @relation(fields:[userId], references:[id])
  userId      String
  title       String
  prompt      String
  modelName   String
  licence     String   // e.g. CC0, Non‑commercial
  fileUrl     String
  downloads   Download[]
  createdAt   DateTime @default(now())
}

model Download {
  id        String   @id @default(uuid())
  upload    Upload   @relation(fields: [uploadId], references: [id])
  uploadId  String
  user      User?    @relation("UserDownloads", fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
} 